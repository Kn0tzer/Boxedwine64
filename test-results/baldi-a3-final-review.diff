+GLenum g_allocationError = GL_NO_ERROR;
+GLuint boundTexture(GLenum target) {
+    GLint id = 0;
+    GLenum binding = GL_TEXTURE_BINDING_2D;
+    if (target >= 0x8515 && target <= 0x851A) binding = GL_TEXTURE_BINDING_CUBE_MAP;
+    glGetIntegerv(binding, &id);
+    return (GLuint)id;
+}
